# Copy to .env.local (local dev) and set the same variables in Vercel.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…) — safe in the browser; RLS protects data.
# The legacy "anon" key also works: NEXT_PUBLIC_SUPABASE_ANON_KEY=...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (sb_secret_…) or legacy service_role key. SERVER ONLY — never prefix
# with NEXT_PUBLIC_. Used only to create staff logins and by the setup scripts.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL, used in confirmation / password-reset email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
